#!/bin/sh
# WangertTV – Fremdquellen: Google Chrome (YouTube/Netflix mit Widevine), Spotify Connect (raspotify/librespot),
# Waydroid (Android + Play Store) und Flathub (Spotify-App)
set -e
export DEBIAN_FRONTEND=noninteractive

# optionales Build-Zertifikat (siehe build.sh, WTV_EXTRA_CA) aktivieren
if [ -f /usr/local/share/ca-certificates/wtv-build-extra.crt ]; then
    update-ca-certificates >/dev/null
fi

install -d -m 0755 /etc/apt/keyrings

echo "I: Google Chrome"
curl -fsSL https://dl.google.com/linux/linux_signing_key.pub | gpg --dearmor --yes -o /etc/apt/keyrings/google-chrome.gpg
echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main" \
    > /etc/apt/sources.list.d/google-chrome.list

echo "I: raspotify (Spotify Connect)"
curl -fsSL https://dtcooper.github.io/raspotify/key.asc -o /usr/share/keyrings/raspotify_key.asc
echo "deb [signed-by=/usr/share/keyrings/raspotify_key.asc] https://dtcooper.github.io/raspotify raspotify main" \
    > /etc/apt/sources.list.d/raspotify.list

echo "I: Waydroid"
curl -fsSL https://repo.waydro.id -o /tmp/waydroid-repo.sh && bash /tmp/waydroid-repo.sh trixie \
    || echo "W: Waydroid-Paketquelle nicht verfügbar"
rm -f /tmp/waydroid-repo.sh

echo "I: Kodi-Module für waipu.tv und Widevine (aus Debian sid, nur diese Pakete)"
install -d /etc/apt/preferences.d
printf 'Types: deb\nURIs: http://deb.debian.org/debian\nSuites: sid\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n' \
    > /etc/apt/sources.list.d/wangerttv-sid.sources
printf 'Package: *\nPin: release n=sid\nPin-Priority: -10\n\nPackage: kodi-pvr-waipu kodi-inputstream-adaptive libwebm1\nPin: release n=sid\nPin-Priority: 990\n' \
    > /etc/apt/preferences.d/wangerttv-sid

apt-get update
apt-get install -y kodi-pvr-waipu kodi-inputstream-adaptive || echo "W: neuere Kodi-Module aus sid nicht verfügbar"
apt-get install -y google-chrome-stable
apt-get install -y raspotify || echo "W: raspotify nicht installiert"
apt-get install -y waydroid || echo "W: waydroid nicht installiert"
apt-get install -y wvkbd || echo "W: wvkbd nicht verfügbar"

# Diese Dienste startet WangertTV selbst zum richtigen Zeitpunkt
systemctl disable raspotify.service >/dev/null 2>&1 || true
systemctl disable waydroid-container.service >/dev/null 2>&1 || true

echo "I: Flathub + Spotify"
flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
if ! flatpak install --system -y --noninteractive flathub com.spotify.Client; then
    # Spotify lädt beim Installieren Zusatzdaten nach (braucht User-Namespaces, die es im Build-Container nicht gibt).
    # Halbfertige App entfernen – WangertTV installiert Spotify nach der Einrichtung automatisch; die Laufzeiten bleiben.
    flatpak uninstall --system -y --noninteractive com.spotify.Client >/dev/null 2>&1 || true
    echo "W: Spotify wird nach der Einrichtung automatisch installiert"
fi
