#!/bin/bash
# WangertTV – richtet das frisch kopierte System ein (läuft per chroot im Zielsystem, aufgerufen von wtv-install).
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive LC_ALL=C.UTF-8

# Benutzer "tv": meldet sich automatisch an (kein Anmeldebildschirm). Passwort nur für Wartung/sudo.
for g in render bluetooth netdev plugdev dialout input video audio; do
    getent group "$g" >/dev/null || groupadd -r "$g"
done
if ! id tv >/dev/null 2>&1; then
    useradd -m -s /bin/bash -c "WangertTV" -G sudo,video,render,input,audio,bluetooth,netdev,plugdev,dialout,users tv
fi
echo "tv:wangerttv" | chpasswd
install -d -o tv -g tv -m 0755 /home/tv/Bilder

# Name, Sprache, Zeit, Tastatur (der Einrichtungsassistent passt das beim ersten Start an)
echo "wangerttv-box" > /etc/hostname
cat > /etc/hosts <<'EOF'
127.0.0.1   localhost
127.0.1.1   wangerttv-box
::1         localhost ip6-localhost ip6-loopback
EOF
printf 'PRETTY_HOSTNAME="WangertTV Box"\nCHASSIS=embedded\n' > /etc/machine-info
echo 'LANG=de_DE.UTF-8' > /etc/default/locale
ln -sf /usr/share/zoneinfo/Europe/Berlin /etc/localtime
echo "Europe/Berlin" > /etc/timezone
cat > /etc/default/keyboard <<'EOF'
XKBMODEL="pc105"
XKBLAYOUT="de"
XKBVARIANT=""
XKBOPTIONS=""
EOF
: > /etc/machine-id
rm -f /var/lib/dbus/machine-id

# Live-System-Teile entfernen
apt-get purge -y live-boot live-boot-initramfs-tools live-config live-config-systemd live-tools >/dev/null 2>&1 || true
rm -f /etc/sudoers.d/live

# Dienste
systemctl enable greetd.service wtv-remote.service wtv-update-check.timer wtv-autoupdate.timer NetworkManager.service \
    bluetooth.service avahi-daemon.service >/dev/null 2>&1 || true
systemctl set-default graphical.target >/dev/null 2>&1 || true

# Bootanimation + Startmanager (GRUB, unsichtbar; Shift/Esc beim Start zeigt das Menü)
plymouth-set-default-theme wangerttv >/dev/null 2>&1 || true
update-initramfs -u -k all
grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=WangertTV --recheck
# Zusätzlich als Standard-Bootpfad (manche Mini-PC-BIOS ignorieren neue Booteinträge)
grub-install --target=x86_64-efi --efi-directory=/boot/efi --removable --no-nvram || true
update-grub
echo "WangertTV-Zielsystem eingerichtet."
