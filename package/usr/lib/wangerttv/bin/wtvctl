#!/usr/bin/python3
"""wtvctl – Kommandozeilen-Steuerung für WangertTV (wird von Tastenkürzeln und Diensten genutzt).

  wtvctl home | settings | power | standby | wake | volume up|down|mute | keyboard | action <aktion>
"""
import json
import os
import shutil
import subprocess
import sys
import urllib.request

PORT = int(os.environ.get("WTV_PORT", "8765"))


def post(path, body=None):
    req = urllib.request.Request(
        f"http://127.0.0.1:{PORT}{path}", data=json.dumps(body or {}).encode(),
        headers={"Content-Type": "application/json", "X-WTV": "1"}, method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.loads(resp.read() or b"{}")
    except OSError as exc:
        print(f"WangertTV-Dienst nicht erreichbar: {exc}", file=sys.stderr)
        return None


def toggle_keyboard():
    """Bildschirmtastatur für andere Apps (z. B. Netflix-Anmeldung) ein-/ausblenden."""
    if subprocess.run(["pkill", "-x", "wvkbd-mobintl"], check=False).returncode == 0:
        return
    if shutil.which("wvkbd-mobintl"):
        subprocess.Popen(["wvkbd-mobintl", "-L", "320"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main(argv):
    if not argv:
        print(__doc__)
        return 1
    cmd = argv[0]
    if cmd == "home":
        post("/api/home")
    elif cmd == "settings":
        post("/api/remote/action", {"action": "settings"})
    elif cmd == "power":
        post("/api/powerkey")
    elif cmd in ("standby", "wake"):
        post("/api/power", {"action": cmd, "source": "key"})
    elif cmd == "volume" and len(argv) > 1:
        action = {"up": "volume_up", "down": "volume_down", "mute": "mute"}.get(argv[1])
        if action:
            post("/api/remote/action", {"action": action})
    elif cmd == "keyboard":
        toggle_keyboard()
    elif cmd == "action" and len(argv) > 1:
        post("/api/remote/action", {"action": argv[1]})
    else:
        print(__doc__)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
