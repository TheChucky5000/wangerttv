<?xml version="1.0" encoding="UTF-8"?>
<!-- WangertTV: Info-Leiste für Live-TV (wird vom Dienst service.wangerttv gefüllt) -->
<window>
  <defaultcontrol always="true">9000</defaultcontrol>
  <zorder>2</zorder>
  <animation effect="fade" start="0" end="100" time="220">WindowOpen</animation>
  <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
  <controls>
    <control type="button" id="9000">
      <left>-100</left><top>-100</top><width>1</width><height>1</height>
      <texturefocus/><texturenofocus/><label/>
    </control>
    <control type="image">
      <left>0</left><top>440</top><width>1920</width><height>640</height>
      <texture>shade.png</texture>
      <animation effect="slide" start="0,80" end="0,0" time="260" tween="cubic" easing="out">WindowOpen</animation>
    </control>
    <control type="group">
      <animation effect="slide" start="0,60" end="0,0" time="280" tween="cubic" easing="out">WindowOpen</animation>
      <animation effect="slide" start="0,0" end="0,60" time="200" tween="cubic" easing="in">WindowClose</animation>
      <!-- Beschreibung (OK / Info) -->
      <control type="group">
        <visible>!String.IsEmpty(Window.Property(expanded))</visible>
        <animation effect="fade" time="180">VisibleChange</animation>
        <control type="image">
          <left>60</left><top>420</top><width>1800</width><height>300</height>
          <texture border="20" colordiffuse="E00B111C">rounded.png</texture>
        </control>
        <control type="label">
          <left>100</left><top>442</top><width>1720</width><height>44</height>
          <font>font30_title</font><textcolor>FF6FB8FF</textcolor>
          <label>$INFO[Window.Property(episode)]</label>
        </control>
        <control type="textbox">
          <left>100</left><top>490</top><width>1720</width><height>210</height>
          <font>font27</font><textcolor>FFE6EDF7</textcolor>
          <label>$INFO[Window.Property(plot)]</label>
          <autoscroll delay="5000" time="2500" repeat="8000">true</autoscroll>
        </control>
      </control>
      <!-- Leiste -->
      <control type="image">
        <left>60</left><top>740</top><width>1800</width><height>310</height>
        <texture border="20" colordiffuse="E00B111C">rounded.png</texture>
      </control>
      <control type="image">
        <left>80</left><top>740</top><width>1760</width><height>3</height>
        <texture colordiffuse="$INFO[Window.Property(accent)]">white.png</texture>
        <visible>!String.IsEmpty(Window.Property(accent))</visible>
      </control>
      <control type="image">
        <left>92</left><top>772</top><width>262</width><height>148</height>
        <texture border="16" colordiffuse="1AFFFFFF">rounded.png</texture>
      </control>
      <control type="image">
        <left>112</left><top>786</top><width>222</width><height>120</height>
        <aspectratio>keep</aspectratio>
        <texture background="true">$INFO[Window.Property(logo)]</texture>
        <fadetime>150</fadetime>
      </control>
      <control type="label">
        <left>112</left><top>786</top><width>222</width><height>120</height>
        <align>center</align><aligny>center</aligny><font>font30_title</font><wrapmultiline>true</wrapmultiline>
        <label>$INFO[Window.Property(name)]</label>
        <visible>String.IsEmpty(Window.Property(logo))</visible>
      </control>
      <control type="label">
        <left>92</left><top>930</top><width>262</width><height>56</height>
        <align>center</align><aligny>center</aligny><font>font45_title</font><textcolor>FF6FB8FF</textcolor>
        <label>$INFO[Window.Property(digits)]</label>
        <visible>!String.IsEmpty(Window.Property(digits))</visible>
      </control>
      <control type="grouplist">
        <left>384</left><top>764</top><width>1000</width><height>52</height>
        <orientation>horizontal</orientation><itemgap>16</itemgap>
        <control type="label">
          <width>auto</width><height>52</height><aligny>center</aligny>
          <font>font37</font><textcolor>FF6FB8FF</textcolor>
          <label>$INFO[Window.Property(number)]</label>
        </control>
        <control type="label">
          <width>auto</width><height>52</height><aligny>center</aligny>
          <font>font36_title</font><textcolor>FFFFFFFF</textcolor>
          <label>$INFO[Window.Property(name)]</label>
        </control>
        <control type="label">
          <width>auto</width><height>52</height><aligny>center</aligny>
          <font>font25_title</font><textcolor>FFFFD24A</textcolor>
          <label>$INFO[Window.Property(hint)]</label>
        </control>
      </control>
      <control type="label">
        <left>1580</left><top>762</top><width>250</width><height>56</height>
        <align>right</align><aligny>center</aligny><font>font45</font><textcolor>FFFFFFFF</textcolor>
        <label>$INFO[System.Time]</label>
      </control>
      <control type="label">
        <left>384</left><top>820</top><width>1446</width><height>62</height>
        <aligny>center</aligny><font>font45_title</font><textcolor>FFFFFFFF</textcolor><scroll>true</scroll>
        <label>$INFO[Window.Property(title)]</label>
      </control>
      <control type="progress" id="20">
        <left>384</left><top>896</top><width>1060</width><height>10</height>
        <texturebg border="5" colordiffuse="30FFFFFF">rounded.png</texturebg>
        <midtexture border="5" colordiffuse="FF3FA9FF">rounded.png</midtexture>
        <lefttexture/><righttexture/><overlaytexture/>
        <visible>!String.IsEmpty(Window.Property(times))</visible>
      </control>
      <control type="label">
        <left>1460</left><top>880</top><width>370</width><height>42</height>
        <align>right</align><aligny>center</aligny><font>font27</font><textcolor>CCFFFFFF</textcolor>
        <label>$INFO[Window.Property(times)]</label>
      </control>
      <control type="label">
        <left>384</left><top>922</top><width>1446</width><height>40</height>
        <aligny>center</aligny><font>font27</font><textcolor>99FFFFFF</textcolor>
        <label>$INFO[Window.Property(next)]</label>
      </control>
      <control type="grouplist">
        <left>384</left><top>976</top><width>1446</width><height>46</height>
        <orientation>horizontal</orientation><itemgap>12</itemgap>
        <visible>String.IsEmpty(Window.Property(preview))</visible>
          <control type="button">
            <width>auto</width><height>46</height>
            <label>$INFO[Window.Property(b_quality)]</label>
            <font>font25_title</font><textcolor>FFFFFFFF</textcolor><disabledcolor>FFFFFFFF</disabledcolor>
            <textoffsetx>18</textoffsetx><aligny>center</aligny>
            <texturenofocus border="14" colordiffuse="FFC8921C">rounded.png</texturenofocus>
            <texturefocus border="14" colordiffuse="FFC8921C">rounded.png</texturefocus>
            <enable>false</enable>
            <visible>String.IsEqual(Window.Property(b_quality),UHD)</visible>
          </control>
          <control type="button">
            <width>auto</width><height>46</height>
            <label>$INFO[Window.Property(b_quality)]</label>
            <font>font25_title</font><textcolor>FFFFFFFF</textcolor><disabledcolor>FFFFFFFF</disabledcolor>
            <textoffsetx>18</textoffsetx><aligny>center</aligny>
            <texturenofocus border="14" colordiffuse="FF1D6FE0">rounded.png</texturenofocus>
            <texturefocus border="14" colordiffuse="FF1D6FE0">rounded.png</texturefocus>
            <enable>false</enable>
            <visible>!String.IsEmpty(Window.Property(b_quality)) + !String.IsEqual(Window.Property(b_quality),UHD)</visible>
          </control>
          <control type="button">
            <width>auto</width><height>46</height>
            <label>$INFO[Window.Property(b_hdr)]</label>
            <font>font25_title</font><textcolor>FFFFFFFF</textcolor><disabledcolor>FFFFFFFF</disabledcolor>
            <textoffsetx>18</textoffsetx><aligny>center</aligny>
            <texturenofocus border="14" colordiffuse="FF7B3CFF">rounded.png</texturenofocus>
            <texturefocus border="14" colordiffuse="FF7B3CFF">rounded.png</texturefocus>
            <enable>false</enable>
            <visible>!String.IsEmpty(Window.Property(b_hdr))</visible>
          </control>
          <control type="button">
            <width>auto</width><height>46</height>
            <label>$INFO[Window.Property(b_vcodec)]</label>
            <font>font25_title</font><textcolor>FFFFFFFF</textcolor><disabledcolor>FFFFFFFF</disabledcolor>
            <textoffsetx>18</textoffsetx><aligny>center</aligny>
            <texturenofocus border="14" colordiffuse="40FFFFFF">rounded.png</texturenofocus>
            <texturefocus border="14" colordiffuse="40FFFFFF">rounded.png</texturefocus>
            <enable>false</enable>
            <visible>!String.IsEmpty(Window.Property(b_vcodec))</visible>
          </control>
          <control type="button">
            <width>auto</width><height>46</height>
            <label>$INFO[Window.Property(b_audio)]</label>
            <font>font25_title</font><textcolor>FFFFFFFF</textcolor><disabledcolor>FFFFFFFF</disabledcolor>
            <textoffsetx>18</textoffsetx><aligny>center</aligny>
            <texturenofocus border="14" colordiffuse="FF0F8A6E">rounded.png</texturenofocus>
            <texturefocus border="14" colordiffuse="FF0F8A6E">rounded.png</texturefocus>
            <enable>false</enable>
            <visible>!String.IsEmpty(Window.Property(b_audio))</visible>
          </control>
          <control type="button">
            <width>auto</width><height>46</height>
            <label>$INFO[Window.Property(b_channels)]</label>
            <font>font25_title</font><textcolor>FFFFFFFF</textcolor><disabledcolor>FFFFFFFF</disabledcolor>
            <textoffsetx>18</textoffsetx><aligny>center</aligny>
            <texturenofocus border="14" colordiffuse="FF0F8A6E">rounded.png</texturenofocus>
            <texturefocus border="14" colordiffuse="FF0F8A6E">rounded.png</texturefocus>
            <enable>false</enable>
            <visible>!String.IsEmpty(Window.Property(b_channels))</visible>
          </control>
          <control type="button">
            <width>auto</width><height>46</height>
            <label>$INFO[Window.Property(b_bitstream)]</label>
            <font>font25_title</font><textcolor>FFFFFFFF</textcolor><disabledcolor>FFFFFFFF</disabledcolor>
            <textoffsetx>18</textoffsetx><aligny>center</aligny>
            <texturenofocus border="14" colordiffuse="40FFFFFF">rounded.png</texturenofocus>
            <texturefocus border="14" colordiffuse="40FFFFFF">rounded.png</texturefocus>
            <enable>false</enable>
            <visible>!String.IsEmpty(Window.Property(b_bitstream))</visible>
          </control>
      </control>
    </control>
  </controls>
</window>
