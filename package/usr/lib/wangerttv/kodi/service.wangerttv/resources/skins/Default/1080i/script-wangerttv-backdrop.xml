<?xml version="1.0" encoding="UTF-8"?>
<!-- WangertTV: Hintergrund hinter dem Fernsehbild. Kodi zeigt ihn statt seiner eigenen Menüs, z. B. in der kurzen
     Pause beim Umschalten – so sieht man nie, dass Kodi dahinter arbeitet. -->
<window>
  <defaultcontrol always="true">9000</defaultcontrol>
  <backgroundcolor>FF04080F</backgroundcolor>
  <controls>
    <control type="button" id="9000">
      <left>-100</left><top>-100</top><width>1</width><height>1</height>
      <texturefocus/><texturenofocus/><label/>
    </control>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture>backdrop.png</texture>
    </control>
    <control type="group">
      <visible>!String.IsEmpty(Window.Property(busy))</visible>
      <animation effect="fade" start="0" end="100" time="300" delay="400">Visible</animation>
      <control type="image">
      <left>900</left><top>428</top><width>120</width><height>120</height>
        <texture>ring.png</texture>
        <animation effect="rotate" end="-360" center="auto" time="1400" loop="true" condition="true">Conditional</animation>
      </control>
      <control type="image">
        <left>928</left><top>456</top><width>64</width><height>64</height>
        <texture>mark.png</texture>
      </control>
      <control type="label">
        <left>460</left><top>580</top><width>1000</width><height>60</height>
        <align>center</align><aligny>center</aligny><font>font32_title</font><textcolor>FFE6EDF7</textcolor>
        <label>$INFO[Window.Property(busy)]</label>
      </control>
    </control>
  </controls>
</window>
