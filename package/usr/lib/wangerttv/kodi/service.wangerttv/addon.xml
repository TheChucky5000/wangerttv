<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.wangerttv" name="WangertTV" version="1.0.41" provider-name="WangertTV">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
  </requires>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="de_DE">WangertTV-Oberfläche für Live-TV</summary>
    <summary lang="en_GB">WangertTV interface for live TV</summary>
    <description lang="de_DE">Info-Leiste im WangertTV-Stil mit Bild- und Tonformat, Umschalten in der WangertTV-Senderreihenfolge und Rückkehr zur WangertTV-Startseite.</description>
    <description lang="en_GB">WangertTV-style info bar with video and audio format, zapping in WangertTV channel order and return to the WangertTV home screen.</description>
    <platform>all</platform>
    <license>Proprietary</license>
  </extension>
</addon>
